FROM python:3.11.15-alpine3.23@sha256:f73754c398b259dfbbe482361dca8b464dea57da74efe5214966ca2ee767ee12

RUN python3 -m pip install --no-cache-dir "numpy==2.4.6" \
    && python3 -m pip uninstall --yes pip setuptools wheel

ARG SOURCE_MANIFEST_SHA256=unbound

LABEL io.sktelecom.ossp.source-manifest-sha256="${SOURCE_MANIFEST_SHA256}"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/opt/router \
    PYTHONUNBUFFERED=1 \
    TMPDIR=/tmp

COPY --chown=65532:65532 src/placer/router /opt/router/router/
COPY --chown=65532:65532 src/placer/artifacts/router-v2.json /opt/router/router/
COPY --chown=65532:65532 container/entrypoint_placer.py /opt/router/entrypoint.py


WORKDIR /opt/router

USER 65532:65532

ENTRYPOINT ["python3", "/opt/router/entrypoint.py"]
